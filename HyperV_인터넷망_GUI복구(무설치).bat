@echo off
chcp 65001 > nul
setlocal enabledelayedexpansion

:: 관리자 권한 확인 및 승격
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo ========================================================
    echo  Hyper-V 인터넷망 네트워크 자동 복구 - 관리자 권한 필요
    echo ========================================================
    echo  관리자 권한 승격을 요청합니다...
    powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Process '%~f0' -Verb RunAs"
    exit /b
)

echo [안내] Hyper-V 인터넷망 GUI 복구 툴을 실행합니다...
echo.

:: PowerShell EncodedCommand 실행 (특수문자 및 한글 깨짐 100% 방지)
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 

exit /b 0
