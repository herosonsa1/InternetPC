{
  "system-guardrails": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./.agents/scripts/guardrail.ps1",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
