@echo off
chcp 65001 > nul
setlocal enabledelayedexpansion

title Hyper-V 인터넷망 가상스위치 원클릭 자동 복구

:: 관리자 권한 확인 및 승격
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo ========================================================
    echo  Hyper-V 인터넷망 네트워크 자동 복구 - 관리자 권한 필요
    echo ========================================================
    echo  관리자 권한 승격을 요청합니다...
    powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Process '%~f0' -Verb RunAs"
    exit /b
)

echo [안내] Hyper-V 인터넷망 자동 복구 및 가상PC 재부팅을 시작합니다...
echo.

:: PowerShell EncodedCommand 실행 (화면 출력 실시간 보장)
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 

exit /b 0
